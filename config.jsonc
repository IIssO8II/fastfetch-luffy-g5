{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "~/.config/fastfetch/images/luffy.png",
        "type": "kitty-direct",
        "height": 20,
        "width": 48,
        "padding": { "top": 2, "left": 8, "right": 8 }
    },
    "display": {
        "separator": " 󰁔 "
    },
    "modules": [
        "break",
        { "type": "custom", "format": "\u001b[31m󰣇 SYSTEM INFORMATION" },
        { "type": "os", "key": "      OS      ", "keyColor": "31" },
        { "type": "kernel", "key": "      Kernel  ", "keyColor": "31" },
        { "type": "wm", "key": "      WM      ", "keyColor": "31" },
        { "type": "shell", "key": "      Shell   ", "keyColor": "31" },
        { "type": "packages", "format": "{} (pacman)", "key": "      Pkgs    ", "keyColor": "31" },
        "break",
        { "type": "custom", "format": "\u001b[33m󰓓 HARDWARE GEAR" },
        { "type": "cpu", "format": "{1}", "key": "      CPU     ", "keyColor": "33" },
        { "type": "gpu", "format": "{2}", "key": "      GPU     ", "keyColor": "33" },
        { "type": "gpu", "format": "{3}", "key": "      VRAM    ", "keyColor": "33" },
        { "type": "display", "key": "      Res     ", "keyColor": "33" },
        "break",
        { "type": "custom", "format": "\u001b[32m󰍛 USAGE STATUS" },
        { "type": "memory", "key": "    󰍛  RAM     ", "keyColor": "32" },
        { "type": "disk", "key": "      Disk    ", "keyColor": "32" },
        { "type": "uptime", "key": "      Up      ", "keyColor": "32" },
        {
            "type": "command",
            "key": "    󱦟  Age     ",
            "keyColor": "32",
            "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
        },
        "break",
        { "type": "custom", "format": "Hay que vivir sin arrepentirnos de nada, Luffy  ~ Gold D. Ace" },
        "break"
    ]
}
